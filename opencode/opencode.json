{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "general",
  "model": "openrouter/xiaomi/mimo-v2.5",
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "general": {
      "mode": "primary",
      "prompt": "You are a friendly general-purpose assistant. Chat naturally and helpfully."
    },
  },
  "permission": {
    "bash": {
      "git commit*": "ask",
      "git push*": "ask"
    }
  }
}
