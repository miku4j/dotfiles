{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "general",
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "general": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
      "mode": "primary",
      "prompt": "You are a friendly general-purpose assistant. Chat naturally and helpfully."
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    },
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    }
  },
  "permission": {
    "bash": {
      "git commit*": "ask",
      "git push*": "ask"
    }
  }
}
