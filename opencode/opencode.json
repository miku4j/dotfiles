{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "general",
  "small_model": "opencode-go/mimo-v2.5",
  "instructions": ["AGENTS.md"],
  "agent": {
    "general": {
      "mode": "primary",
      "prompt": "You are a friendly general-purpose assistant. Chat naturally and helpfully."
    }
  },
  "permission": {
    "bash": {
      "git commit*": "ask",
      "git push*": "ask"
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath=/usr/sbin/chromium"
      ],
      "enabled": true
    }
  },
  "provider": {
    "openrouter-custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter Custom",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "includeUsage": true
      },
      "models": {
        "deepseek/deepseek-v4-flash-0731": {
          "name": "Deepseek V4 Custom",
          "options": {
            "provider": {
              // "allow_fallbacks": false,
              // "only": ["gmicloud"]
              "sort": {
                "by": "price",
                "partition": "none"
              },
              "preferred_min_throughput": {
                "p50": 100
              }
            }
          }
        },
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash Custom",
          "cost": { "input": 0.075, "output": 0.25 },
          "options": {
            "reasoning": { "effort": "low" },
            "provider": {
              "allow_fallbacks": false,
              "only": ["z-ai"]
              // "sort": {
              //   "by": "price",
              //   "partition": "none"
              // },
              // "preferred_min_throughput": {
              //   "p90": 100
              // }
            }
          },
          "variants": {
            "high": { "reasoning": { "effort": "high" } },
            "max": { "reasoning": { "effort": "max" } }
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "inclusionai/ling-3.0-flash": {
          "options": {
            "provider": {
              // "allow_fallbacks": false,
              // "only": ["novita"]
              "preferred_min_throughput": {
                "p50": 55
              }
            }
          }
        },
        "deepseek/deepseek-v4-flash-0731": {
          "options": {
            "provider": {
              // "allow_fallbacks": false,
              // "only": ["relace"]
              "preferred_min_throughput": {
                "p50": 55
              }
            }
          }
        },
        "z-ai/glm-5.3-flash": {
          "options": {
            "provider": {
              // "allow_fallbacks": false,
              // "only": ["deepinfra"]
              "sort": {
                "by": "price",
                "partition": "none"
              },
              "preferred_min_throughput": {
                "p50": 55
              }
            }
          }
        }
      }
    }
  }
}
