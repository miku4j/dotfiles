{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "general",
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/deepseek-v4-flash",
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "general": {
      "mode": "primary",
      "prompt": "You are a friendly general-purpose assistant. Chat naturally and helpfully."
    },
  },
  "permission": {
    "bash": {
      "git commit*": "ask",
      "git push*": "ask"
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--headless", "--executablePath=/usr/sbin/chromium"],
      "enabled": true
    }
  }
}
